{
  "name": "agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run typecheck && npm test && node scripts/preflight.mjs && wrangler deploy && node ../admin-cli/index.mjs init",
    "deploy:staging": "npm run typecheck && npm test && node scripts/preflight.mjs --env staging && wrangler deploy --env staging && node ../admin-cli/index.mjs init --staging",
    "smoke": "node scripts/smoke.mjs",
    "smoke:staging": "node scripts/smoke.mjs --url https://salt-agent-staging.dhairyashah98.workers.dev",
    "rollback": "wrangler rollback",
    "types": "wrangler types",
    "chat": "node scripts/chat.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.60",
    "@cloudflare/shell": "^0.4.3",
    "@cloudflare/think": "^0.17.0",
    "@evan/opus": "^1.0.3",
    "agents": "^0.22.0",
    "ai": "^7.0.93",
    "jose": "^6.2.12",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.42.0"
  }
}
