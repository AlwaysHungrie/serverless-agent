{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serverless-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "dev": { "port": 8787 },
  "durable_objects": {
    "bindings": [
      { "name": "SessionAgent", "class_name": "SessionAgent" },
      { "name": "SessionRegistry", "class_name": "SessionRegistry" },
      { "name": "MessengerAgent", "class_name": "MessengerAgent" },
      { "name": "ThinkMessengerStateAgent", "class_name": "ThinkMessengerStateAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["SessionRegistry"] },
    { "tag": "v3", "new_sqlite_classes": ["MessengerAgent", "ThinkMessengerStateAgent"] }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "serverless-agent-files" }
  ],
  "vars": {
    "MODEL": "deepseek/deepseek-v4-flash",
    "TELEGRAM_BOT_USERNAME": ""
  }
}
